# Google Calendar API Configuration

# Your Google Calendar ID (e.g., hairbydekyi@gmail.com)
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# Google Spreadsheet ID for bookings and schedule
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# Base64 encoded service account key JSON
# To encode: cat service-account-key.json | base64
GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_json_here

#resend api key for email notifications
RESEND_API_KEY=re_api_key_here

# Admin panel password — REQUIRED (no fallback). Use a strong, unique value
ADMIN_PASSWORD=set_a_strong_password_here

# HMAC key used to sign admin session cookies — REQUIRED (no fallback).
# If unset, admin login is disabled (fails closed). Generate with:
#   openssl rand -hex 32
AUTH_SECRET=replace_with_a_long_random_string

# Base URL for the website (used in emails)
BASE_URL=https://www.hairbydekyi.com

# Shared secret that protects the cron-only endpoints
# (check-bookings, check-deposits, check-expired-holds).
# cron-job.org must send this as `Authorization: Bearer <value>` or `?key=<value>`.
# Generate a strong one with: openssl rand -hex 32
CRON_SECRET=replace_with_a_long_random_string
